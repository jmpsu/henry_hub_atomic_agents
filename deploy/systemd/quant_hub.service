[Unit]
Description=Henry Hub Point-in-Time Quant Command Hub
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=joey
WorkingDirectory=/opt/quant-hub/current
Environment=PATH=/opt/quant-hub/current/.venv/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/opt/quant-hub/shared/.env
ExecStart=/opt/quant-hub/current/.venv/bin/uvicorn command_hub:app --host 127.0.0.1 --port 8090
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
