/* Kumo dark-mode token overrides, from `_kumo_dark.scss`. Opt-in per page:
   the login and verify code pages add it only when the org has no saved
   background (see `adaptiveStylesheet` in `core/theme.ts`). */

/* Light mode: show the dark-ink logo, hide the light-ink one. */
.base_AccessLogo .logo-dark {
  display: none;
}

@media (prefers-color-scheme: dark) {
  :root {
    color-scheme: dark;

    /* Surfaces */
    --color-kumo-canvas: oklch(10% 0 0); /* neutral-1000 */
    --color-kumo-elevated: oklch(12% 0 0); /* neutral-975 */
    --color-kumo-recessed: oklch(15% 0 0); /* neutral-950 */
    --color-kumo-base: oklch(17% 0 0); /* neutral-925, card surface */
    --color-kumo-tint: oklch(26.9% 0 0); /* neutral-800 */
    --color-kumo-control: oklch(21% 0.006 285.885); /* neutral-900 */

    /* Lines & fills */
    --color-kumo-line: oklch(32% 0 0); /* neutral-750 */
    --color-kumo-hairline: oklch(26.9% 0 0); /* neutral-800 */
    --color-kumo-fill: oklch(26.9% 0 0); /* neutral-800 */
    --color-kumo-focus: oklch(93.5% 0 0); /* neutral-150 */
    --color-kumo-danger: oklch(70.4% 0.191 22.216); /* red-400, destructive button fill */
    --color-kumo-success: oklch(76.5% 0.177 163.223); /* emerald-400 */

    /* Text */
    --text-color-kumo-default: oklch(97% 0 0); /* neutral-100 */
    --text-color-kumo-subtle: oklch(70.8% 0 0); /* neutral-400 */
    --text-color-kumo-placeholder: oklch(55.6% 0 0); /* neutral-500 */
    --text-color-kumo-link: oklch(70.7% 0.165 254.624); /* blue-400 */
    --text-color-kumo-info: oklch(70.7% 0.165 254.624); /* blue-400 */
    --text-color-kumo-warning: oklch(85.2% 0.199 91.936); /* yellow-400 */
    --text-color-kumo-danger: oklch(70.4% 0.191 22.216); /* red-400 */
    --text-color-kumo-success: oklch(90.5% 0.093 164.15); /* emerald-200 */
  }

  /* Swap the Access logo to the light-ink variant. */
  .base_AccessLogo .logo-light {
    display: none;
  }

  .base_AccessLogo .logo-dark {
    display: inline;
  }

  .Message-is-info {
    background: oklch(70.7% 0.165 254.624 / 0.12);
    border-color: oklch(70.7% 0.165 254.624 / 0.4);
  }

  .Message-is-warning {
    background: oklch(85.2% 0.199 91.936 / 0.12);
    border-color: oklch(85.2% 0.199 91.936 / 0.4);
  }

  .Message-is-error {
    background: oklch(70.4% 0.191 22.216 / 0.12);
    border-color: oklch(70.4% 0.191 22.216 / 0.4);
  }

  .Message-is-success,
  .resend-confirmation {
    background: oklch(90.5% 0.093 164.15 / 0.12);
    border-color: oklch(90.5% 0.093 164.15 / 0.4);
  }
}

:root {
  --page-bg-override: var(--color-kumo-canvas);
}

body {
  color: var(--text-color-kumo-default);
}

/* The illustration keeps its intrinsic 184px width, as on the legacy page,
   whose `.svg-wrapper img` rule never matched the inlined <svg>. */
.svg-wrapper {
  width: 160px;
}

/* Links inside the message (.Result heading and copy live in base.css). */
.Result a,
.Result a:visited {
  color: var(--text-color-kumo-link);
}

/* Retry form sits full-width below the message. */
.AuthBox-body form {
  width: 100%;
  margin-top: calc(var(--spacing) * 2);
}

/* Debug details: recessed panel inside the card. */
.DebugDetails {
  width: 100%;
  margin-top: calc(var(--spacing) * 2);
  padding: calc(var(--spacing) * 4);
  background: var(--color-kumo-tint);
  border: 1px solid var(--color-kumo-hairline);
  border-radius: var(--radius-md);
  text-align: left;
  font-size: 13px;
  line-height: 18px;
}

/* Content-driven, center-weighted rows. */
.responsive-info {
  display: grid;
  grid-template-columns: max-content minmax(0, max-content);
  justify-content: center;
  column-gap: calc(var(--spacing) * 2);
  row-gap: calc(var(--spacing) * 2);
}

.responsive-info .info-group {
  display: contents;
}

.responsive-info .info-label {
  text-align: right;
  font-weight: 500;
  color: var(--text-color-kumo-subtle);
}

.responsive-info .info-value {
  text-align: left;
  color: var(--text-color-kumo-default);
  line-break: anywhere;
}

/* Click-to-reveal control for sensitive debug values, styled as a link. */
.RevealButton {
  appearance: none;
  -webkit-appearance: none;
  padding: 0;
  border: 0;
  background: none;
  font: inherit;
  color: var(--text-color-kumo-link);
  text-decoration: underline;
  text-underline-offset: 2px;
  cursor: pointer;
}

.RevealButton:focus-visible {
  outline: 2px solid var(--color-kumo-brand);
  outline-offset: 2px;
  border-radius: var(--radius-sm);
}

.DebugActions {
  display: flex;
  justify-content: center;
}

@media (max-width: 480px) {
  .svg-wrapper {
    width: 128px;
  }

  /* Stack rows (label above value, left-aligned) on narrow screens. */
  .responsive-info {
    display: block;
  }

  .responsive-info .info-group {
    display: block;
  }

  .responsive-info .info-group + .info-group {
    margin-top: calc(var(--spacing) * 2);
  }

  .responsive-info .info-label,
  .responsive-info .info-value {
    text-align: left;
  }
}
