    border-color 120ms ease,
    color 120ms ease,
    box-shadow 120ms ease,
    transform 60ms ease;
}

.Button:focus-visible {
  outline-offset: 2px;
}

.Button:active {
  transform: translateY(0.5px);
}

.Button:disabled {
  opacity: 0.5;
  cursor: not-allowed;
  transform: none;
}

.Button-is-block {
  width: 100%;
}

.Button-is-primary,
.Button-is-destructive,
.Button-is-interstitial-deny,
.Button-is-interstitial-approve {
  background: -webkit-gradient(
    linear,
    left top,
    left bottom,
    from(color-mix(in oklch, var(--button-emphasis-color), white 15%)),
    to(var(--button-emphasis-color))
  );
  background: linear-gradient(
    to bottom,
    color-mix(in oklch, var(--button-emphasis-color), white 15%),
    var(--button-emphasis-color)
  );
  color: #fff;
  border-color: color-mix(in oklch, var(--button-emphasis-color), black 10%);
}

.Button-is-primary:hover:not(:disabled),
.Button-is-destructive:hover:not(:disabled),
.Button-is-interstitial-deny:hover:not(:disabled),
.Button-is-interstitial-approve:hover:not(:disabled) {
  background: -webkit-gradient(
    linear,
    left top,
    left bottom,
    from(color-mix(in oklch, var(--button-emphasis-color), white 30%)),
    to(var(--button-emphasis-color))
  );
  background: linear-gradient(
    to bottom,
    color-mix(in oklch, var(--button-emphasis-color), white 30%),
    var(--button-emphasis-color)
  );
}

.Button-is-primary {
  --button-emphasis-color: var(--color-kumo-brand);
}

.Button-is-destructive {
  --button-emphasis-color: var(--color-kumo-danger);
}

.Button-is-interstitial-deny {
  --button-emphasis-color: var(--color-interstitial-deny);
}

.Button-is-interstitial-approve {
  --button-emphasis-color: var(--color-interstitial-approve);
}

