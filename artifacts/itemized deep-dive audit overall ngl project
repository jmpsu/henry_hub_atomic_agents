519:                               (hdd["latest_target_timestamp"], cutoff)).fetchone()
520:             norm = nr[0] if nr else None
521:         st = [latest.get(a) for a in DRIVER_GROUPS[2][2]]
522:         st_ok = [r for r in st if r and r["provenance"] == "measured"]
523:         derived = {"hdd_anomaly": {"value": (hdd["value"] - norm) if (hdd and norm is not None and hdd["provenance"] == "measured") else None,
