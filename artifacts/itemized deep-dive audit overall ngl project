507:         # ---- drivers
508:         def driver(agent):
509:             r = latest.get(agent)
510:             if not r or r["provenance"] == "unverified_seed":
511:                 return {"agent_id": agent, "status": PENDING, "value": None, "provenance": None}
512:             return {"agent_id": agent, "status": r["provenance"], "value": r["value"], "unit": r["unit"], "target_date": r["latest_target_timestamp"][:10],
