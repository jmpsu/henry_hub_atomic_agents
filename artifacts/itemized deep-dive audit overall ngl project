107: def sma(values, window: int) -> np.ndarray:
108:     a = np.asarray(values, dtype=float)
109:     out = np.full(a.shape, np.nan)
110:     if len(a) >= window:
111:         c = np.cumsum(np.insert(a, 0, 0.0))
112:         out[window - 1:] = (c[window:] - c[:-window]) / window
113:     return out
