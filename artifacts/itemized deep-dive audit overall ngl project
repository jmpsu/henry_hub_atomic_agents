271: def curve_regime(points: list, flat_band: float = 0.05) -> str:
272:     """Contango when the back of the curve is above the front by more than flat_band, backwardation when below."""
273:     if len(points) < 2:
274:         return "UNAVAILABLE"
275:     slope = points[-1]["value"] - points[0]["value"]
276:     return "CONTANGO" if slope > flat_band else "BACKWARDATION" if slope < -flat_band else "FLAT"
