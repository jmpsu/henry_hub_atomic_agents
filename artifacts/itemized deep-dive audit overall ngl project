200:
201: def swing_points(values, window: int = 3) -> tuple[list, list]:
202:     """Indices of local highs and lows: the extreme of the surrounding +/- window bars. A flat top or bottom counts once,
203:     at its first bar (flat tops are exactly what an ascending triangle is made of)."""
204:     a = np.asarray(values, dtype=float)
205:     hi, lo = [], []
206:     for i in range(window, len(a) - window):
207:         seg = a[i - window:i + window + 1]
208:         if a[i] == seg.max() and a[i] > a[i - 1]:
209:             hi.append(i)
210:         if a[i] == seg.min() and a[i] < a[i - 1]:
211:             lo.append(i)
212:     return hi, lo
213:
214:
215: def triangle_detection(dates, values, lookback: int = 60, flat_pct_per_bar: float = 0.04) -> dict:
216:     """Fit lines through the swing highs and swing lows of the last `lookback` bars and classify the shape.
217:     A side is 'flat' when its slope is under flat_pct_per_bar % of the mean price per bar. The lines must converge."""
218:     a = np.asarray(values[-lookback:], dtype=float)
219:     d = list(dates[-lookback:])
220:     none = {"pattern": "none", "lookback": len(a)}
221:     if len(a) < 20:
222:         return none
223:     hi, lo = swing_points(a)
224:     if len(hi) < 2 or len(lo) < 2:
225:         return none
226:     mh, bh = np.polyfit(hi, a[hi], 1)
227:     ml, bl = np.polyfit(lo, a[lo], 1)
228:     n = len(a) - 1
229:     u0, u1, l0, l1 = bh, mh * n + bh, bl, ml * n + bl
230:     flat = abs(float(a.mean())) * flat_pct_per_bar / 100.0
231:     converging = (u1 - l1) < (u0 - l0) and (u1 - l1) > 0
232:     up_flat, lo_flat = abs(mh) <= flat, abs(ml) <= flat
233:     if not converging:
234:         pattern = "none"
235:     elif up_flat and ml > flat:
236:         pattern = "ascending_triangle"
237:     elif mh < -flat and ml > flat:
238:         pattern = "symmetrical_triangle"
239:     elif mh < -flat and lo_flat:
240:         pattern = "descending_triangle"
241:     else:
242:         pattern = "none"
243:     out = {"pattern": pattern, "lookback": len(a), "converging": bool(converging),
244:            "upper": {"start_date": d[0], "start": float(u0), "end_date": d[-1], "end": float(u1), "slope_per_bar": float(mh)},
245:            "lower": {"start_date": d[0], "start": float(l0), "end_date": d[-1], "end": float(l1), "slope_per_bar": float(ml)},
246:            "breakout_above": float(u1), "breakdown_below": float(l1), "swing_highs": len(hi), "swing_lows": len(lo)}
247:     if converging and mh != ml:
248:         out["bars_to_apex"] = float((bl - bh) / (mh - ml) - n)
249:     return out
250:
251:
252: def _divergence(price, osc, window: int = 5, lookback: int = 80) -> str:
253:     p = np.asarray(price[-lookback:], dtype=float)
254:     o = np.asarray(osc[-lookback:], dtype=float)
255:     if len(p) < 30:
256:         return "none"
257:     hi, lo = swing_points(p, window)
258:     hi, lo = [i for i in hi if not np.isnan(o[i])], [i for i in lo if not np.isnan(o[i])]   # oscillator warm-up bars don't count
259:     if len(hi) >= 2 and p[hi[-1]] > p[hi[-2]] and o[hi[-1]] < o[hi[-2]]:
260:         return "bearish"
261:     if len(lo) >= 2 and p[lo[-1]] < p[lo[-2]] and o[lo[-1]] > o[lo[-2]]:
262:         return "bullish"
263:     return "none"
