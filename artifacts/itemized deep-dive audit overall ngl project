266: def rsi_macd_divergence(values) -> dict:
267:     """Bearish: price makes a higher swing high while the oscillator makes a lower one. Bullish: the mirror on swing lows."""
268:     return {"rsi": _divergence(values, rsi(values)), "macd": _divergence(values, macd(values)["line"])}
