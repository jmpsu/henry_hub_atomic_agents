186:         return {"status": "insufficient_data"}
187:     ih, il = int(a.argmax()), int(a.argmin())
188:     hi, lo = float(a[ih]), float(a[il])
189:     span = hi - lo
190:     up_leg = il < ih
191:     levels = {f"{r * 100:.1f}%": (hi - span * r) if up_leg else (lo + span * r) for r in FIB_RATIOS}
192:     last = float(a[-1])
193:     nearest = min(levels, key=lambda k: abs(levels[k] - last))
194:     golden = levels["61.8%"]
195:     return {"status": "ok", "swing_high": hi, "swing_high_date": dates[ih], "swing_low": lo, "swing_low_date": dates[il],
196:             "leg": "up" if up_leg else "down", "levels": levels, "last": last, "nearest_level": nearest,
197:             "retracement_pct": ((hi - last) if up_leg else (last - lo)) / span * 100.0 if span else None,
198:             "golden_ratio_distance_pct_of_range": abs(last - golden) / span * 100.0 if span else None}
