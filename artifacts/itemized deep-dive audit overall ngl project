329:
330: def latest_rows(conn, as_of: str) -> dict:
331:     """Newest PIT-eligible row per agent (by target date, then vintage), with its provenance and payload reference.
332:     Real rows always win: an old demo seed row is only reported for an agent that has nothing else."""
333:     cols = ("p.agent_id,p.target_timestamp,p.available_timestamp,p.value,p.unit,p.source_id,p.retrieved_timestamp,p.quality_status,"
334:             "p.raw_payload_hash,p.provenance,p.geographic_scope")
335:     seed = "(COALESCE(quality_status,'')='unverified_seed' OR source_id IS NULL OR source_id='')"
336:     out = {}
337:     for real in (False, True):  # seeds first, then real rows overwrite them
338:         cond = f"NOT {seed}" if real else seed
339:         rows = conn.execute(
340:             f"SELECT {cols} FROM pit_market_data p JOIN (SELECT agent_id, MAX(target_timestamp) t FROM pit_market_data "
341:             f"WHERE available_timestamp<=? AND {cond} GROUP BY agent_id) m ON m.agent_id=p.agent_id AND m.t=p.target_timestamp "
342:             f"WHERE p.available_timestamp<=? AND {cond.replace('quality_status', 'p.quality_status').replace('source_id', 'p.source_id')} "
343:             "ORDER BY p.agent_id, p.available_timestamp", (as_of, as_of)).fetchall()
344:         for r in rows:  # ordered by vintage, so the last one per agent wins
345:             out[r[0]] = {"agent_id": r[0], "latest_target_timestamp": r[1], "available_timestamp": r[2], "value": r[3], "unit": r[4] or "",
346:                          "source_id": r[5], "retrieved_timestamp": r[6], "quality_status": r[7], "raw_payload_hash": r[8] or None,
347:                          "provenance": (r[9] or "measured") if real else "unverified_seed", "geographic_scope": r[10] or ""}
348:     return out
