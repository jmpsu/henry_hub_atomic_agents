116: def ema(values, span: int) -> np.ndarray:
117:     a = np.asarray(values, dtype=float)
118:     out = np.empty(a.shape)
119:     if not len(a):
120:         return out
121:     k = 2.0 / (span + 1.0)
122:     out[0] = a[0]
123:     for i in range(1, len(a)):
124:         out[i] = k * a[i] + (1 - k) * out[i - 1]
