398: def build_state(db_path: str, product: str | None = None, timeframe: str = "seasonal", as_of: str | None = None,
399:                 knowledge: dict | None = None) -> dict:
400:     cutoff = pit_cutoff(as_of)
401:     product = product if product in PRODUCTS else active_product()
402:     timeframe = timeframe if timeframe in TIMEFRAMES else "seasonal"
403:     meta, tf = PRODUCTS[product], TIMEFRAMES[timeframe]
404:     conn = _conn(db_path)
405:     try:
406:         cache: dict[str, list] = {}
407:
408:         def series(agent):
409:             if agent not in cache:
410:                 cache[agent] = load_series(conn, agent, cutoff)
411:             return cache[agent]
412:
413:         latest = latest_rows(conn, cutoff)
414:         stats = {"pit_rows": conn.execute("SELECT COUNT(*) FROM pit_market_data WHERE available_timestamp<=?", (cutoff,)).fetchone()[0],
415:                  "raw_payloads": conn.execute("SELECT COUNT(*) FROM raw_payloads").fetchone()[0]}
416:         payload_hashes = {r[0] for r in conn.execute("SELECT raw_payload_hash FROM raw_payloads")}
417:         wti = series(WTI_AGENT)
418:
419:         # ---- product availability
420:         products = []
421:         for key, m in PRODUCTS.items():
422:             s = series(m["agent_id"])
423:             products.append({"id": key, "label": m["label"], "code": m["code"], "unit": m["unit"], "agent_id": m["agent_id"],
424:                              "status": "measured" if len(s) >= 30 else PENDING, "observations": len(s),
425:                              "latest": s[-1][1] if s else None, "latest_date": s[-1][0] if s else None,
426:                              "pct_of_wti": (wti_ratio(s[-1][1], wti[-1][1]) if (s and wti and m["unit"] == "cents/gal") else None)})
427:
428:         # ---- active product: price, technicals, seasonal
429:         full = series(meta["agent_id"])
430:         n = tf["sessions"]
431:         state: dict[str, Any] = {}
432:         if len(full) >= 30:
433:             dates, vals = [r[0] for r in full], [r[1] for r in full]
434:             v = slice(max(0, len(vals) - n), len(vals))
435:             vd, vv = dates[v], vals[v]
436:             bb, mc, r14 = bollinger(vals), macd(vals), rsi(vals)
437:             s20, s50, s200 = sma(vals, 20), sma(vals, 50), sma(vals, 200)
438:             crosses = [c for c in ma_crossovers(dates, vals) if c["date"] >= vd[0]]
439:             fib, tri, div = fibonacci(vd, vv), triangle_detection(dates, vals, lookback=min(60, n)), rsi_macd_divergence(vals)
440:             prev = vals[-2] if len(vals) > 1 else vals[-1]
441:             wk = vals[-6] if len(vals) > 5 else vals[0]
442:             price = {"status": "measured", "provenance": "measured", "value": vals[-1], "unit": meta["unit"], "date": dates[-1],
443:                      "available_timestamp": full[-1][2], "change_1d": vals[-1] - prev, "change_1d_pct": (vals[-1] / prev - 1) * 100 if prev else None,
444:                      "change_5d": vals[-1] - wk, "change_5d_pct": (vals[-1] / wk - 1) * 100 if wk else None,
445:                      "window_high": max(vv), "window_low": min(vv),
446:                      "pct_of_wti": wti_ratio(vals[-1], wti[-1][1]) if (wti and meta["unit"] == "cents/gal") else None}
447:             state["series"] = {"status": "measured", "dates": vd, "values": vv}
448:             state["technicals"] = {
449:                 "status": "ok", "sma20": s20[v], "sma50": s50[v], "sma200": s200[v],
450:                 "bollinger": {"upper": bb["upper"][v], "lower": bb["lower"][v], "mid": bb["mid"][v], "bandwidth_pct": bb["bandwidth_pct"][v],
451:                               "squeeze": bb["squeeze"][v], "squeeze_threshold_pct": bb["squeeze_threshold"], "squeeze_active": bool(bb["squeeze"][-1])},
452:                 "rsi14": r14[v], "macd": {"line": mc["line"][v], "signal": mc["signal"][v], "hist": mc["hist"][v]},
453:                 "crossovers": crosses[-8:], "fibonacci": fib, "triangle": tri, "divergence": div,
454:                 "summary": {"last": vals[-1], "sma50": s50[-1], "sma200": s200[-1],
455:                             "trend": ("above_200dma" if vals[-1] > s200[-1] else "below_200dma") if not math.isnan(s200[-1]) else "insufficient_history",
456:                             "ma_regime": ("golden" if s50[-1] > s200[-1] else "death") if not (math.isnan(s50[-1]) or math.isnan(s200[-1])) else "insufficient_history",
457:                             "rsi14": r14[-1], "macd_hist": mc["hist"][-1], "bollinger_squeeze": bool(bb["squeeze"][-1]),
458:                             "bandwidth_pct": bb["bandwidth_pct"][-1], "triangle": tri["pattern"], "divergence_rsi": div["rsi"], "divergence_macd": div["macd"]}}
459:             state["seasonal"] = {"status": "ok", **seasonal_overlay(dates, vals, int(cutoff[:4]))}
460:         else:
