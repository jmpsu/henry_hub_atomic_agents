308:
309: def pit_cutoff(as_of: str | None) -> str:
310:     """Normalise the requested cutoff to the stored 'YYYY-MM-DDTHH:MM:SSZ' form; default is now. Raises ValueError."""
311:     if not as_of:
312:         return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
313:     dt = datetime.fromisoformat(str(as_of).strip().replace("Z", "+00:00"))
314:     if dt.tzinfo is None:
315:         dt = dt.replace(tzinfo=timezone.utc)
316:     return dt.astimezone(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
