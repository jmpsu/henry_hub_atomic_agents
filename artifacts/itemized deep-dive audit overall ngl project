319: def load_series(conn, agent_id: str, as_of: str) -> list[tuple]:
320:     """[(date, value, available_timestamp)] for MEASURED rows only: latest vintage with available_timestamp <= as_of."""
321:     rows = conn.execute(
322:         "SELECT p.target_timestamp, p.value, p.available_timestamp FROM pit_market_data p WHERE p.agent_id=? AND p.available_timestamp<=? "
323:         "AND COALESCE(p.provenance,'measured')='measured' AND COALESCE(p.quality_status,'')<>'unverified_seed' "
324:         "AND p.available_timestamp=(SELECT MAX(q.available_timestamp) FROM pit_market_data q WHERE q.agent_id=p.agent_id "
325:         "AND q.target_timestamp=p.target_timestamp AND q.available_timestamp<=?) ORDER BY p.target_timestamp", (agent_id, as_of, as_of)).fetchall()
326:     assert all(r[2] <= as_of for r in rows), "LOOK-AHEAD: row published after the cutoff"
327:     return [(r[0][:10], float(r[1]), r[2]) for r in rows]
