128: def bollinger(values, window: int = 20, k: float = 2.0, squeeze_pct: float = 20.0) -> dict:
129:     """SMA +/- k sigma, bandwidth % of the mid, and a squeeze flag where bandwidth <= its squeeze_pct percentile."""
130:     a = np.asarray(values, dtype=float)
131:     n = len(a)
132:     mid, up, lo, bw = (np.full(n, np.nan) for _ in range(4))
133:     if n >= window:
134:         w = np.lib.stride_tricks.sliding_window_view(a, window)
135:         m, s = w.mean(axis=1), w.std(axis=1)
136:         mid[window - 1:], up[window - 1:], lo[window - 1:] = m, m + k * s, m - k * s
137:         with np.errstate(divide="ignore", invalid="ignore"):
138:             bw[window - 1:] = np.where(m != 0, (2 * k * s) / m * 100.0, np.nan)
139:     valid = bw[~np.isnan(bw)]
140:     thr = float(np.percentile(valid, squeeze_pct)) if len(valid) else None
141:     squeeze = (bw <= thr) if thr is not None else np.zeros(n, dtype=bool)
142:     return {"mid": mid, "upper": up, "lower": lo, "bandwidth_pct": bw, "squeeze": squeeze, "squeeze_threshold": thr}
