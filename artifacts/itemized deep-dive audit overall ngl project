145: def rsi(values, period: int = 14) -> np.ndarray:
146:     """Wilder RSI."""
147:     a = np.asarray(values, dtype=float)
148:     out = np.full(a.shape, np.nan)
149:     if len(a) <= period:
150:         return out
151:     d = np.diff(a)
152:     g, l = np.where(d > 0, d, 0.0), np.where(d < 0, -d, 0.0)
153:     ag, al = g[:period].mean(), l[:period].mean()
154:     for i in range(period, len(d) + 1):
155:         if i > period:
156:             ag = (ag * (period - 1) + g[i - 1]) / period
157:             al = (al * (period - 1) + l[i - 1]) / period
158:         out[i] = 100.0 if al < 1e-12 else 100.0 - 100.0 / (1.0 + ag / al)
159:     return out
