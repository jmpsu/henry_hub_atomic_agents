351: def _clean(x):
352:     """JSON-safe: numpy scalars to Python, NaN/inf to None, floats rounded."""
353:     if isinstance(x, dict):
354:         return {k: _clean(v) for k, v in x.items()}
355:     if isinstance(x, (list, tuple)):
356:         return [_clean(v) for v in x]
357:     if isinstance(x, np.ndarray):
358:         return [_clean(v) for v in x.tolist()]
359:     if isinstance(x, (np.bool_, bool)):
360:         return bool(x)
361:     if isinstance(x, (np.integer,)):
362:         return int(x)
363:     if isinstance(x, (float, np.floating)):
364:         f = float(x)
365:         return None if (math.isnan(f) or math.isinf(f)) else round(f, 4)
366:     return x
