472:                 return {"status": PENDING, "agent_id": PRODUCTS[key]["agent_id"]}
473:             return {"status": "measured", "dates": [a[0] for a in al], "pct_of_wti": [wti_ratio(a[1], a[2]) for a in al],
474:                     "latest": wti_ratio(al[-1][1], al[-1][2])}
475:
476:         mb, cw = series(PRODUCTS["propane"]["agent_id"]), series(CONWAY_AGENT)
477:         hub = _aligned(mb, cw)[-252:]
478:         eth, hh = series(PRODUCTS["ethane"]["agent_id"]), series(PRODUCTS["henry_hub"]["agent_id"])
479:         fr = _aligned(eth, hh)[-252:]
480:         fwd = []
481:         for m_ in range(1, 13):
482:             r = latest.get(f"Agent_HH_M{m_}")
483:             if r and r["provenance"] == "measured":
484:                 fwd.append({"contract": f"M{m_}", "value": r["value"], "date": r["latest_target_timestamp"][:10], "available_timestamp": r["available_timestamp"]})
485:         fwd_dates = {p["date"] for p in fwd}
486:         fwd_age = _age_days(max(p["available_timestamp"] for p in fwd), cutoff) if fwd else None
487:         fwd_stale = bool(fwd) and (len(fwd_dates) > 1 or (fwd_age is not None and fwd_age > 10))
488:         curves = {
489:             "ngl_to_wti_pct": {"formula": "(cents/gal / 100 * 42) / WTI_usd_bbl * 100", "wti": {"status": "measured" if wti else PENDING,
490:                                "value": wti[-1][1] if wti else None, "date": wti[-1][0] if wti else None, "unit": "USD/bbl"},
491:                                "propane": pct_curve("propane"), "normal_butane": pct_curve("normal_butane"), "natural_gasoline": pct_curve("natural_gasoline")},
492:             "hub_spread": ({"status": "measured", "dates": [a[0] for a in hub], "mont_belvieu": [a[1] for a in hub], "conway": [a[2] for a in hub],
493:                             "spread_mb_minus_conway": [a[1] - a[2] for a in hub], "unit": "cents/gal"} if len(hub) >= 30 else
494:                            {"status": PENDING, "missing": [CONWAY_AGENT], "unit": "cents/gal",
495:                             "mont_belvieu_latest": mb[-1][1] if mb else None, "note": "Conway has no collector, so no spread is shown."}),
496:             "frac_spread": ({"status": "measured", "dates": [a[0] for a in fr], "ethane_usd_mmbtu": [ethane_usd_mmbtu(a[1]) for a in fr],
497:                              "henry_hub_usd_mmbtu": [a[2] for a in fr], "frac_spread_usd_mmbtu": [frac_spread(a[1], a[2]) for a in fr],
498:                              "regime": "RECOVERY" if frac_spread(fr[-1][1], fr[-1][2]) > 0 else "REJECTION"} if len(fr) >= 30 else
499:                             {"status": PENDING, "missing": [PRODUCTS["ethane"]["agent_id"]], "formula": "(cents/gal / 100) / 0.0665 - Henry Hub",
500:                              "henry_hub_latest": hh[-1][1] if hh else None, "note": "Ethane has no collector, so recovery vs rejection cannot be computed."}),
501:             "forward_curve": {"status": "measured" if fwd else PENDING, "points": fwd, "regime": curve_regime(fwd) if fwd else "UNAVAILABLE",
502:                               "stale": fwd_stale, "as_of_date": max(fwd_dates) if fwd else None, "age_days": fwd_age,
503:                               "missing": [f"Agent_HH_M{m_}" for m_ in range(1, 13) if f"Agent_HH_M{m_}" not in {('Agent_HH_' + p['contract']) for p in fwd}],
504:                               "note": "EIA stopped publishing its NYMEX contract 1-4 series on 2024-04-05; M5-M12 have no collector." if fwd_stale else ""},
505:         }
