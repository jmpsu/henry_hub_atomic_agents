279: def seasonal_overlay(dates, values, as_of_year: int, years_back: int = 5, step: int = 7) -> dict:
280:     """Calendar-aligned band from the previous `years_back` complete years, plus the current year's path."""
281:     by_year: dict[int, dict[int, float]] = {}
282:     for d, v in zip(dates, values):
283:         y, doy = int(d[:4]), datetime.strptime(d, "%Y-%m-%d").timetuple().tm_yday
284:         by_year.setdefault(y, {})[min(doy, 365)] = v
285:     hist = [y for y in range(as_of_year - years_back, as_of_year) if len(by_year.get(y, {})) >= 150]
286:     grid = list(range(1, 366, step))
287:
288:     def at(year, doy):
289:         ys = by_year.get(year, {})
290:         near = [k for k in ys if abs(k - doy) <= 3]
291:         return ys[min(near, key=lambda k: abs(k - doy))] if near else None
292:
293:     bmin, bmax, bavg, cur = [], [], [], []
294:     for g in grid:
295:         vals = [v for v in (at(y, g) for y in hist) if v is not None]
296:         bmin.append(min(vals) if vals else None)
297:         bmax.append(max(vals) if vals else None)
298:         bavg.append(sum(vals) / len(vals) if vals else None)
299:         cur.append(at(as_of_year, g))
300:     return {"day_of_year": grid, "history_years": hist, "current_year": as_of_year, "band_min": bmin, "band_max": bmax,
301:             "band_avg": bavg, "current": cur, "lines": {str(y): [at(y, g) for g in grid] for y in hist}}
